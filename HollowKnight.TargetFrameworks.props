<Project>
  <PropertyGroup>
    <GameLibsPackageVersion Condition="'$(GameLibsPackageVersion)' == ''">1.0.0</GameLibsPackageVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFramework)' == 'hk1221'">
    <HollowKnightVersion>1.2.2.1</HollowKnightVersion>
    <ModdingApiVersion>42hksr</ModdingApiVersion>
    <TargetFrameworkIdentifier>.NETFramework</TargetFrameworkIdentifier>
    <TargetFrameworkVersion>v3.5</TargetFrameworkVersion>
    <ModTargetPrefix Condition="'$(HK1221Prefix)' != ''">$(HK1221Prefix)</ModTargetPrefix>
    <ModVersion Condition="'$(HK1221Version)' != ''">$(HK1221Version)</ModVersion>
    <RepackDependencies>true</RepackDependencies>
    <ModsLayout>flat</ModsLayout>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'hk1315'">
    <HollowKnightVersion>1.3.1.5</HollowKnightVersion>
    <ModdingApiVersion>74hksr</ModdingApiVersion>
    <TargetFrameworkIdentifier>.NETFramework</TargetFrameworkIdentifier>
    <TargetFrameworkVersion>v3.5</TargetFrameworkVersion>
    <ModTargetPrefix Condition="'$(HK1315Prefix)' != ''">$(HK1315Prefix)</ModTargetPrefix>
    <ModVersion Condition="'$(HK1315Version)' != ''">$(HK1315Version)</ModVersion>
    <ModsLayout>subdirectory</ModsLayout>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'hk1432'">
    <HollowKnightVersion>1.4.3.2</HollowKnightVersion>
    <ModdingApiVersion>74hksr</ModdingApiVersion>
    <TargetFrameworkIdentifier>.NETFramework</TargetFrameworkIdentifier>
    <TargetFrameworkVersion>v3.5</TargetFrameworkVersion>
    <ModTargetPrefix Condition="'$(HK1432Prefix)' != ''">$(HK1432Prefix)</ModTargetPrefix>
    <ModVersion Condition="'$(HK1432Version)' != ''">$(HK1432Version)</ModVersion>
    <ModsLayout>subdirectory</ModsLayout>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'hk1578'">
    <HollowKnightVersion>1.5.78.11833</HollowKnightVersion>
    <ModdingApiVersion>77</ModdingApiVersion>
    <TargetFrameworkIdentifier>.NETFramework</TargetFrameworkIdentifier>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <ModTargetPrefix Condition="'$(HK1578Prefix)' != ''">$(HK1578Prefix)</ModTargetPrefix>
    <ModVersion Condition="'$(HK1578Version)' != ''">$(HK1578Version)</ModVersion>
    <ModsLayout>subdirectory</ModsLayout>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'silksong'">
    <TargetFrameworkIdentifier>.NETStandard</TargetFrameworkIdentifier>
    <TargetFrameworkVersion>v2.1</TargetFrameworkVersion>
    <ModTargetPrefix Condition="'$(SilkPrefix)' != ''">$(SilkPrefix)</ModTargetPrefix>
    <ModTargetPrefix Condition="'$(ModTargetPrefix)' == ''">silk</ModTargetPrefix>
    <ModVersion Condition="'$(SilkVersion)' != ''">$(SilkVersion)</ModVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TargetFrameworkVersion)' != ''">
    <ModTargetPrefix Condition="'$(ModTargetPrefix)' == ''">$(TargetFramework)</ModTargetPrefix>
    <TargetFrameworkMoniker>$(TargetFrameworkIdentifier),Version=$(TargetFrameworkVersion)</TargetFrameworkMoniker>
    <!-- define constant like HK1221 / SILKSONG -->
    <DefineConstants>$(DefineConstants);$(TargetFramework.ToUpper())</DefineConstants>
  </PropertyGroup>

  <ItemGroup Condition="'$(HollowKnightVersion)' != ''">
    <PackageReference Include="HollowKnight.GameLibs"
                      Version="[$(GameLibsPackageVersion)-hollowknight.$(HollowKnightVersion).api$(ModdingApiVersion)]"
                      PrivateAssets="all"
                      NoWarn="NU1601" />
  </ItemGroup>
</Project>
