<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="HollowKnight.TargetFrameworks.props" />

  <PropertyGroup>
    <TargetFrameworks>silksong;hk1578;hk1432;hk1315;hk1221</TargetFrameworks>
    <AssemblyName>FsmMaster</AssemblyName>
    <RootNamespace>FsmMaster</RootNamespace>
    <!-- Incorporates code derived from Silksong.FsmUtil (EUPL-1.2, (c) silksong-modding) - see
         PlayMakerFsmOps.cs. -->
    <PackageLicenseExpression>EUPL-1.2</PackageLicenseExpression>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <EnableNETAnalyzers>True</EnableNETAnalyzers>
    <AnalysisMode>recommended</AnalysisMode>
    <NoWarn>$(NoWarn);MSB3270</NoWarn>

    <RestorePackagesWithLockFile>True</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">True</RestoreLockedMode>

    <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)=/</PathMap>

    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/ConstructiveCynicism/FsmMaster</RepositoryUrl>

    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src/FsmMaster.Core/**/*.cs" Exclude="src/**/obj/**;src/**/bin/**" />
    <Compile Include="src/FsmMaster.HK1221/**/*.cs" Exclude="src/**/obj/**;src/**/bin/**" Condition="'$(TargetFramework)' == 'hk1221'" />
    <Compile Include="src/FsmMaster.HK1578/**/*.cs" Exclude="src/**/obj/**;src/**/bin/**" Condition="'$(TargetFramework)' == 'hk1315' Or '$(TargetFramework)' == 'hk1432' Or '$(TargetFramework)' == 'hk1578'" />
    <Compile Include="src/FsmMaster.Silksong/**/*.cs" Exclude="src/**/obj/**;src/**/bin/**" Condition="'$(TargetFramework)' == 'silksong'" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Unity.Analyzers" Version="1.25.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(RepackDependencies)' == 'true'">
    <PackageReference Include="HarmonyX" Version="2.9.0" />
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.34" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'silksong'">
    <PackageReference Include="BepInEx.Analyzers" Version="1.0.8" PrivateAssets="all" />
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="HarmonyX" Version="2.9.0" />
    <PackageReference Include="Hamunii.BepInEx.AutoPlugin" Version="2.0.1" PrivateAssets="all" />
    <PackageReference Include="UnityEngine.Modules" Version="6000.0.50" IncludeAssets="compile" />
    <PackageReference Include="Silksong.GameLibs" Version="*-*" PrivateAssets="all" />
    <PackageReference Include="Silksong.I18N" Version="1.1.1" />
    <PackageReference Include="Silksong.DebugMod" Version="1.1.0" IncludeAssets="compile" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="True" PackagePath="README.md" />
  </ItemGroup>

  <PropertyGroup>
    <ModsFolder Condition="'$(TargetFramework)' == 'hk1221'">$(HK1221ModsFolder)</ModsFolder>
    <ModsFolder Condition="'$(TargetFramework)' == 'hk1315'">$(HK1315ModsFolder)</ModsFolder>
    <ModsFolder Condition="'$(TargetFramework)' == 'hk1432'">$(HK1432ModsFolder)</ModsFolder>
    <ModsFolder Condition="'$(TargetFramework)' == 'hk1578'">$(HK1578ModsFolder)</ModsFolder>
    <CopyDestinationFolder Condition="'$(ModsLayout)' == 'flat'">$(ModsFolder)</CopyDestinationFolder>
    <CopyDestinationFolder Condition="'$(ModsLayout)' == 'subdirectory' And '$(ModsFolder)' != ''">$(ModsFolder)/$(AssemblyName)</CopyDestinationFolder>
    <CopyDestinationGuardFolder Condition="'$(ModsFolder)' != ''">$(ModsFolder)</CopyDestinationGuardFolder>
    <!-- Release (and any Debug build without a scripts folder configured) installs into the plugin's
         own folder under BepInEx/plugins. When a scripts folder is set, Debug builds are copied loose
         into it instead so BepInEx's ScriptEngine hot-reloads them. -->
    <CopyDestinationFolder Condition="'$(TargetFramework)' == 'silksong' And '$(SilksongPluginsFolder)' != ''">$(SilksongPluginsFolder)/$(AssemblyName)</CopyDestinationFolder>
    <CopyDestinationFolder Condition="'$(TargetFramework)' == 'silksong' And '$(Configuration)' == 'Debug' And '$(SilksongScriptsFolder)' != ''">$(SilksongScriptsFolder)</CopyDestinationFolder>
    <CopyDestinationGuardFolder Condition="'$(TargetFramework)' == 'silksong'">$(SilksongFolder)</CopyDestinationGuardFolder>
  </PropertyGroup>

  <Target Name="CopyToModsFolder" AfterTargets="Build;ILRepacker" Condition="'$(CopyDestinationFolder)' != '' And Exists('$(CopyDestinationGuardFolder)')">
    <ItemGroup>
      <Binaries Include="$(TargetPath)" />
      <Binaries Include="$(TargetDir)/$(TargetName).pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(Binaries)" DestinationFolder="$(CopyDestinationFolder)/" />
  </Target>

  <!-- Manual-install zips, laid out so their contents drop straight into the game's Managed/Mods
       folder: flat for hk1221's old loader, nested under FsmMaster/ for the subdirectory loaders. -->
  <Target Name="CreateReleaseZip" AfterTargets="Build;ILRepacker" Condition="'$(Configuration)' == 'Release' And '$(HollowKnightVersion)' != ''">
    <ItemGroup>
      <ReleaseBinaries Include="$(TargetPath)" />
      <ReleaseBinaries Include="$(TargetDir)/$(TargetName).pdb" />
    </ItemGroup>
    <!-- Property-scoped to this target (not a top-level PropertyGroup) because it has to read
         $(IntermediateOutputPath) after the SDK appends the per-TFM suffix - a top-level PropertyGroup
         evaluates before that suffix exists and silently resolves to a drive-rooted path instead. -->
    <PropertyGroup>
      <ReleaseZipBinariesDir Condition="'$(GITHUB_ACTIONS)' == 'true' Or '$(TargetFramework)' == 'hk1221'">$(IntermediateOutputPath)/archive/</ReleaseZipBinariesDir>
      <ReleaseZipBinariesDir Condition="'$(ReleaseZipBinariesDir)' == ''">$(IntermediateOutputPath)/archive/FsmMaster/</ReleaseZipBinariesDir>
    </PropertyGroup>
    <RemoveDir Directories="$(IntermediateOutputPath)/archive" />
    <Copy SourceFiles="@(ReleaseBinaries)" DestinationFolder="$(ReleaseZipBinariesDir)" />
    <Copy SourceFiles="$(RepoRoot)README.md" DestinationFolder="$(IntermediateOutputPath)/archive/" />
    <Copy SourceFiles="$(RepoRoot)LICENSE" DestinationFolder="$(IntermediateOutputPath)/archive/" />
    <MakeDir Directories="$(ReleaseOutputFolder)" />
    <Delete Files="$(ReleaseOutputFolder)/$(ModReleaseName).zip" />
    <ZipDirectory SourceDirectory="$(IntermediateOutputPath)/archive" DestinationFile="$(ReleaseOutputFolder)/$(ModReleaseName).zip" Overwrite="True" />
  </Target>

  <!-- Release packaging: builds the Thunderstore package and a manual-install zip, both
       bundling Silksong.ModList the same way DebugMod's release process does. Gated to
       Release so hot-reload debug builds during live gameplay stay fast and offline. -->
  <Target Name="PackageThunderstoreMod" AfterTargets="Build;ILRepacker" Condition="'$(Configuration)' == 'Release' And '$(TargetFramework)' == 'silksong'">
    <ItemGroup>
      <ThunderstoreBinaries Include="$(TargetPath)" LocalDir="/" PackDir="/plugins" />
      <ThunderstoreBinaries Include="$(TargetDir)/$(TargetName).pdb" LocalDir="/" PackDir="/plugins" />
    </ItemGroup>
    <PropertyGroup>
      <ThunderstoreDir>$(RepoRoot)thunderstore</ThunderstoreDir>
    </PropertyGroup>
    <RemoveDir Directories="$(ThunderstoreDir)/temp;$(ThunderstoreDir)/build" />
    <MakeDir Directories="$(ThunderstoreDir)/temp" />
    <Copy SourceFiles="@(ThunderstoreBinaries)" DestinationFolder="$(ThunderstoreDir)/temp/%(ThunderstoreBinaries.PackDir)" />
    <Exec Command="dotnet tool restore" WorkingDirectory="$(RepoRoot)" />
    <!-- The Thunderstore package keeps its own stable identity (FsmMaster) - the prefixed release name
         is for the downloadable zip, not for the package listing existing installs update from. -->
    <Exec Command="dotnet tcli build --config-path &quot;$(ThunderstoreDir)/thunderstore.toml&quot; --package-name &quot;$(AssemblyTitle)&quot; --package-version $(ModVersion)" StandardOutputImportance="High" StandardErrorImportance="High" WorkingDirectory="$(RepoRoot)" />
  </Target>

  <Target Name="CreateSilksongReleaseZip" AfterTargets="Build;ILRepacker" Condition="'$(Configuration)' == 'Release' And '$(TargetFramework)' == 'silksong'">
    <ItemGroup>
      <ReleaseBinaries Include="$(TargetPath)" LocalDir="/" />
      <ReleaseBinaries Include="$(TargetDir)/$(TargetName).pdb" LocalDir="/" />
    </ItemGroup>
    <PropertyGroup>
      <ThunderstoreDir>$(RepoRoot)thunderstore</ThunderstoreDir>
      <ModlistVersion>0.3.1</ModlistVersion>
      <ModlistUrl>https://github.com/silksong-modding/Silksong.ModList/releases/download/v$(ModlistVersion)/silksong_modding-Modlist-$(ModlistVersion).zip/</ModlistUrl>
    </PropertyGroup>
    <RemoveDir Directories="$(IntermediateOutputPath)/archive" />
    <Copy SourceFiles="@(ReleaseBinaries)" DestinationFolder="$(IntermediateOutputPath)/archive/$(TargetName)/%(ReleaseBinaries.LocalDir)" />
    <DownloadFile Condition="!Exists('$(IntermediateOutputPath)/Silksong.Modlist.$(ModlistVersion).zip')" SourceUrl="$(ModlistUrl)" DestinationFolder="$(IntermediateOutputPath)" DestinationFileName="Silksong.Modlist.$(ModlistVersion).zip" />
    <Unzip SourceFiles="$(IntermediateOutputPath)/Silksong.Modlist.$(ModlistVersion).zip" DestinationFolder="$(IntermediateOutputPath)/archive/Silksong.Modlist" />
    <Copy SourceFiles="$(RepoRoot)README.md" DestinationFolder="$(IntermediateOutputPath)/archive/" />
    <Copy SourceFiles="$(RepoRoot)LICENSE" DestinationFolder="$(IntermediateOutputPath)/archive/" />
    <MakeDir Directories="$(ReleaseOutputFolder)" />
    <Delete Files="$(ReleaseOutputFolder)/$(ModReleaseName).zip" />
    <ZipDirectory SourceDirectory="$(IntermediateOutputPath)/archive" DestinationFile="$(ReleaseOutputFolder)/$(ModReleaseName).zip" Overwrite="True" />
  </Target>
</Project>
